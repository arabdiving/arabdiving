# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/arabdiving

# Secret used to sign JWTs — use a long random string
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Cloudinary credentials (https://cloudinary.com/console)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

# ── نظام البريد (Email) ─────────────────────────────
# رابط الموقع العام (يُستخدم في روابط التأكيد وإلغاء الاشتراك)
APP_URL=http://localhost:5000

# بيانات SMTP للإرسال الفعلي. اتركها فارغة للعمل في وضع المحاكاة (DRY_RUN).
# مثال Brevo المجاني: أنشئ حساباً على brevo.com ثم SMTP & API → SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login
SMTP_PASS=your_brevo_smtp_key

# عنوان المرسِل الظاهر (يجب أن يكون من دومين موثّق SPF/DKIM)
MAIL_FROM=ArabDiving <no-reply@arabdiving.com>

# هوية المرسِل وعنوانه (إلزامي في تذييل كل رسالة قانونياً)
MAIL_SENDER_NAME=ArabDiving
MAIL_SENDER_ADDRESS=ArabDiving — البحر الأحمر، مصر / السعودية
